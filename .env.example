# Copy this file to .env and adjust. Never commit the real .env.
# (Nothing here is required for local development — the defaults work as-is.)

# Signs the session cookie. Required in production; a throwaway value is
# generated automatically in development. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port the server listens on. Defaults to 8080.
PORT=8080

# Where the SQLite database file lives. Defaults to ./data/mutuo.sqlite
# SQLITE_STORAGE=./data/mutuo.sqlite

# To use MySQL or Postgres instead of SQLite, set a connection URL and the
# matching dialect. When DATABASE_URL is set it takes precedence over SQLite.
#   DATABASE_URL=mysql://user:password@host:3306/mutuo
#   DB_DIALECT=mysql

# Set to true when the database insists on TLS, which every managed Postgres
# does (Render, Heroku, Neon, Supabase). Without it the connection is refused.
# DB_SSL=false

# Set to true to log every SQL statement Sequelize runs.
# SQL_LOG=false

# Contact string sent to OpenStreetMap's geocoder, as their usage policy
# requires. Put your own project URL or email here before deploying.
# MUTUO_CONTACT=mutuo-app (you@example.com)

# Lets `npm run seed` run under NODE_ENV=production, which it otherwise refuses
# to do — it writes accounts whose password is published in the README. Set this
# only on a throwaway public demo that wants exactly that. Seeding stays
# additive: --fresh is refused in production either way.
# MUTUO_DEMO_SEED=false

{
  "name": "mutuo",
  "version": "0.1.0",
  "description": "Mutuo — trade skills with people near you. Teach what you know, learn what you don't.",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yilin-11/mutuo.git"
  },
  "homepage": "https://github.com/yilin-11/mutuo#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "vercel-build": "node scripts/vercel-build.js",
    "test": "cross-env NODE_ENV=test mocha --timeout 10000 --exit",
    "lint": "eslint .",
    "fix": "eslint --fix .",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\"",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "skill-sharing",
    "express",
    "sequelize",
    "passport"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-session-sequelize": "^7.1.7",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7"
  },
  "optionalDependencies": {
    "mysql2": "^3.9.7",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "mocha": "^10.4.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0"
  }
}
